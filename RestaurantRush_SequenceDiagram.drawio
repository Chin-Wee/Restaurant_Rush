        <mxCell id="m69" value="" style="html=1;rounded=0;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#1A1A1A;fontSize=12;fontFamily=Helvetica;dashed=1;" edge="1" parent="1">          <mxGeometry relative="1" as="geometry">            <mxPoint x="2717" y="3197" as="sourcePoint" />            <mxPoint x="485" y="3197" as="targetPoint" />          </mxGeometry></mxCell>
        <mxCell id="m69__t" value="GameResult.VICTORY" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;resizable=0;points=[];autosize=0;fontSize=11;fontFamily=Helvetica;fontColor=#1A1A1A;fontStyle=0;" vertex="1" parent="1">          <mxGeometry x="360" y="3178" width="121" height="16" as="geometry" /></mxCell>
        <mxCell id="n165" value="guards evaluated once, after turn 18: paidCount &amp;gt;= 4 AND revenue &amp;gt;= 4500 cents AND average paid satisfaction &amp;gt;= 60; otherwise DEFEAT. This run: 5 paid, $63.62, average 74.4 -&amp;gt; VICTORY." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" vertex="1" parent="1">          <mxGeometry x="40" y="3231" width="1400" height="37" as="geometry" /></mxCell>
