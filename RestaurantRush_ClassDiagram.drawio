        <mxCell id="b1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="1" vertex="1">
          <mxGeometry height="26" width="26" x="2750" y="840" as="geometry" />
        </mxCell>
        <mxCell id="b2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="2" vertex="1">
          <mxGeometry height="26" width="26" x="3230" y="88" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="3" vertex="1">
          <mxGeometry height="26" width="26" x="1790" y="88" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="4" vertex="1">
          <mxGeometry height="26" width="26" x="2270" y="1344" as="geometry" />
        </mxCell>
        <mxCell id="b5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="5" vertex="1">
          <mxGeometry height="26" width="26" x="1310" y="912" as="geometry" />
        </mxCell>
        <mxCell id="b6" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="6" vertex="1">
          <mxGeometry height="26" width="26" x="830" y="1322" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D6B656;fontSize=12;fontStyle=1;fontColor=#8A6100;" value="7" vertex="1">
          <mxGeometry height="26" width="26" x="830" y="88" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;1 Encapsulation&lt;/b&gt;&lt;br&gt;Satisfaction owns the 0..100 rule: lose()/recover() clamp&lt;br&gt;inside, so no caller can store an invalid value.&lt;br&gt;Order.priceCents has no setter - the bill is frozen when&lt;br&gt;the order is taken. ScoreBoard.revenueCents only&lt;br&gt;grows through addPayment(order)." vertex="1">
          <mxGeometry height="114" width="300" x="40" y="750" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;2 Polymorphism&lt;/b&gt;&lt;br&gt;the control layer only sends chooseItem(), satisfactionLossPerTurn(),&lt;br&gt;applyDiscount(), onServed(), onTurnEnd() and recover() to Customer.&lt;br&gt;Regular 8/turn, VIP 5/turn with 10% off, Critic 12/turn who orders the most&lt;br&gt;expensive item and adds 5 when served promptly. No instanceof and no type&lt;br&gt;switch in the control layer." vertex="1">
          <mxGeometry height="114" width="400" x="2440" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;3 Composition / 4 Aggregation&lt;/b&gt;&lt;br&gt;Restaurant owns its 2 Tables, its WaitingQueue, its Menu and 1..4 Staff -&lt;br&gt;created and destroyed with the run (filled diamond). ComboMeal instead&lt;br&gt;points at two MenuItems owned by the Menu (hollow diamond): the same&lt;br&gt;Dish instance is ordered alone or inside a combo." vertex="1">
          <mxGeometry height="99" width="400" x="2880" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;5 Money&lt;/b&gt;&lt;br&gt;every amount is an integer number of cents (menu, order, revenue); one&lt;br&gt;Math.round per discount step; ConsoleUI.formatCents() is the only place that&lt;br&gt;renders $x.xx." vertex="1">
          <mxGeometry height="84" width="400" x="2440" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;6 Deterministic play&lt;/b&gt;&lt;br&gt;every customer draws from the single Random(randomSeed) built by&lt;br&gt;SimulationConfig: same seed + same manager choices = same run.&lt;br&gt;CriticCustomer needs no randomness at all." vertex="1">
          <mxGeometry height="84" width="400" x="2880" y="1760" as="geometry" />
        </mxCell>
        <mxCell id="n6" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;7 Stages / OCP&lt;/b&gt;&lt;br&gt;Stage 2 added Regular/VIP/CriticCustomer; Stage 3 added Host,&lt;br&gt;Dish/ComboMeal, HappyHourPolicy and BillCalculator. The six steps of&lt;br&gt;playTurn() were never rewritten - new behaviour arrives through subclass&lt;br&gt;overrides, composition and configuration. Host policy: seats one queued&lt;br&gt;customer per turn, FIFO, in addition to the Waiter." vertex="1">
          <mxGeometry height="114" width="400" x="2440" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="n7" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#FFF9C4;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;Pricing pipeline&lt;/b&gt;&lt;br&gt;the bill is built in one place: item price, then the customer&#39;s discount (VIP),&lt;br&gt;then the active HappyHourPolicy (20%), one rounding per step, then locked&lt;br&gt;into Order.priceCents. Switching Happy Hour on earlier or later therefore&lt;br&gt;changes the bill of orders taken in different turns." vertex="1">
          <mxGeometry height="99" width="400" x="2880" y="1960" as="geometry" />
        </mxCell>
        <mxCell id="n8" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;Turn sequence&lt;/b&gt;&lt;br&gt;Step 1 arrival, 2 manager choices, 3 kitchen and serving (Waiter before&lt;br&gt;Chef), 4 eating and payment, 5 waiting loss and abandonment, 6 result - all&lt;br&gt;18 turns. Multiplicities are written at the association ends: 1, 0..1, 0..*, 1..4&lt;br&gt;and 2." vertex="1">
          <mxGeometry height="99" width="400" x="2440" y="2130" as="geometry" />
        </mxCell>
        <mxCell id="n9" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=14;fillColor=#F5F5F5;strokeColor=#9E9E9E;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=5;fontSize=11;fontFamily=Helvetica;lineHeight=1.25;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;+ public, - private, # protected; italics = abstract;&lt;br&gt;underline = static; filled diamond = composition; hollow&lt;br&gt;diamond = aggregation; dashed arrow = dependency;&lt;br&gt;«...» = stereotype." vertex="1">
          <mxGeometry height="99" width="300" x="40" y="990" as="geometry" />
        </mxCell>
        <mxCell id="e_c_menu" edge="1" parent="1" source="rst__r1" style="startArrow=diamondThin;startFill=1;startSize=12;endArrow=none;html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;orthogonalLoop=1;entryPerimeter=0;entryDx=0;entryDy=0;fontSize=11;fontFamily=Helvetica;entryX=0.0000;entryY=0.5000;" target="menu" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="178" />
              <mxPoint x="1380" y="1170" />
              <mxPoint x="1480" y="1170" />
            </Array>
            <mxPoint x="1460" y="178" as="sourcePoint" />
            <mxPoint x="1480" y="1170" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
