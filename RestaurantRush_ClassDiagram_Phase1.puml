@startuml RestaurantRush_ClassDiagram_Phase1
title Restaurant Rush - Phase 1 Class Diagram

' ---------------------------------------------------------------------------
' Rendering
' ---------------------------------------------------------------------------
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 32
skinparam ranksep 50
skinparam padding 4
skinparam ArrowColor #3E4C59
skinparam ArrowThickness 0.9
skinparam classAttributeIconSize 0
skinparam roundcorner 6
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #3E4C59
  FontColor #1F2933
  FontSize 12
  AttributeFontSize 10
  AttributeFontColor #3E4C59
  StereotypeFontSize 9
  StereotypeFontColor #52606D
}

skinparam enum {
  BackgroundColor #F7F9FB
  BorderColor #3E4C59
  FontColor #1F2933
  FontSize 11
}

skinparam class {
  BackgroundColor<<boundary>> #EAF3FB
  BorderColor<<boundary>> #4A7FA5
  BackgroundColor<<control>> #FDF2E3
  BorderColor<<control>> #A56A2A
  BackgroundColor<<entity>> #EDF6EC
  BorderColor<<entity>> #4E7B4A
  BackgroundColor<<value>> #F5F0FA
  BorderColor<<value>> #6B5B8E
}

hide circle
hide empty members

top to bottom direction

legend top right
  Constructors and private helper methods are omitted.
  <<value>> types are immutable Java records: each listed
  field has an implicit public accessor of the same name.
endlegend

' ---------------------------------------------------------------------------
' Boundary and control
' ---------------------------------------------------------------------------
class ConsoleApp <<boundary>> {
  + {static} main(args: String[]) : void
}

class ConsoleUI <<boundary>> {
  - input : Scanner
  - controller : GameController
  - displayedEvents : int
  + run() : void
  + displayTurnStart(snapshot: GameSnapshot) : void
  + promptManagerChoices() : void
  + displayError(message: String) : void
  + displayTurnSummary(resolution: TurnResolution) : void
  + displayEndGameResult(result: GameResult) : void
}

class GameController <<control>> {
  - config : GameConfig
  - restaurant : Restaurant
  - scoreBoard : ScoreBoard
  - customerFactory : CustomerFactory
  - billCalculator : BillCalculator
  - phase : TurnPhase
  - currentTurn : int
  - waiterTaskUsed : boolean
  - turnStarted : boolean
  - newArrival : String
  - events : List<String>
  - paymentRecord : PaymentRecord
  - departures : List<String>
  + phase() : TurnPhase
  + currentTurn() : int
  + randomSeed() : long
  + result() : GameResult
  + beginTurn() : TurnResolution
  + processArrival() : TurnResolution
  + submitTurnChoices(waiterTask: WaiterDecision, chefTask: ChefDecision) : TurnResolution
  + submitWaiterDecision(decision: WaiterDecision) : TurnResolution
  + submitChefDecision(decision: ChefDecision) : TurnResolution
  + snapshot() : GameSnapshot
  + lastResolution() : TurnResolution
}

' ---------------------------------------------------------------------------
' Domain entities
' ---------------------------------------------------------------------------
class Restaurant <<entity>> {
  - waitingQueue : WaitingQueue
  - tables : List<Table>
  - customers : List<Customer>
  - menu : Menu
  - waiter : Waiter
  - chef : Chef
  - cashier : Cashier
  + waitingQueue() : WaitingQueue
  + tables() : List<Table>
  + customers() : List<Customer>
  + menu() : Menu
  + waiter() : Waiter
  + chef() : Chef
  + cashier() : Cashier
  + registerArrival(customer: Customer) : void
  + seat(customer: Customer) : Table
  + tableFor(customer: Customer) : Table
  + oldestPaymentCandidate(turn: int) : Customer
  + completePayment(customer: Customer) : PaymentRecord
  + abandon(customer: Customer) : void
}

abstract class Customer {
  - id : String
  - arrivalOrdinal : int
  - satisfaction : Satisfaction
  - choiceSeed : long
  - state : CustomerState
  - order : Order
  - readyToPayTurn : Integer
  + id() : String
  + arrivalOrdinal() : int
  + satisfaction() : Satisfaction
  + state() : CustomerState
  + order() : Order
  + readyToPayTurn() : Integer
  + chooseItem(menu: Menu) : MenuItem
  {abstract} + satisfactionLossPerTurn() : int
  + isWaitingForTableOrFood() : boolean
  + applyWaitingLoss() : void
  + recover(amount: int) : void
  + markSeated() : void
  + placeOrder(item: MenuItem, lockedPriceCents: int) : Order
  + serveOrder(turn: int) : void
  + finishEating(turn: int) : void
  + canPay(turn: int) : boolean
  + paid() : void
  + leave() : void
}

class RegularCustomer <<entity>> {
  + satisfactionLossPerTurn() : int
}

class WaitingQueue <<entity>> {
  - members : Deque<Customer>
  + enqueue(customer: Customer) : void
  + dequeue() : Customer
  + remove(customer: Customer) : boolean
  + getMembers() : List<Customer>
  + isEmpty() : boolean
}

class Table <<entity>> {
  - tableId : int
  - occupant : Customer
  + tableId() : int
  + assign(customer: Customer) : void
  + vacate() : void
  + isOccupied() : boolean
  + getOccupant() : Customer
}

class Order <<entity>> {
  - item : MenuItem
  - lockedPriceCents : int
  - unitsDone : int
  - status : OrderStatus
  - readyTurn : Integer
  - servedTurn : Integer
  + item() : MenuItem
  + lockedPriceCents() : int
  + unitsDone() : int
  + status() : OrderStatus
  + readyTurn() : Integer
  + servedTurn() : Integer
  + advance(turn: int) : void
  + canServe(turn: int) : boolean
  + serve(turn: int) : void
  + markPaid() : void
  + cancel() : void
}

class Satisfaction <<entity>> {
  - value : int
  + getValue() : int
  + deduct(points: int) : void
  + add(points: int) : void
}

class Menu <<entity>> {
  - items : List<MenuItem>
  + addItem(item: MenuItem) : void
  + getItems() : List<MenuItem>
  + getItemByName(name: String) : MenuItem
}

abstract class MenuItem {
  - name : String
  - basePriceCents : int
  - preparationUnits : int
  + name() : String
  + priceCents() : int
  + preparationUnits() : int
}

class Dish <<entity>> {
  + name() : String
  + priceCents() : int
  + preparationUnits() : int
}

' ---------------------------------------------------------------------------
' Staff and supporting services
' ---------------------------------------------------------------------------
class Waiter {
  + seat(restaurant: Restaurant, customer: Customer) : void
  + takeOrder(customer: Customer, menu: Menu, calculator: BillCalculator, turn: int) : Order
  + serve(customer: Customer, turn: int) : void
}

class Chef {
  + advance(customer: Customer, turn: int) : void
}

class Cashier {
  + collectOldest(restaurant: Restaurant, turn: int) : PaymentRecord
}

class BillCalculator {
  + quote(item: MenuItem, customer: Customer, turn: int) : int
}

class ScoreBoard {
  - servedCount : int
  - unhappyDepartures : int
  - revenueCents : int
  - paidSatisfactionTotal : int
  - paidCount : int
  + recordServed() : void
  + recordPayment(record: PaymentRecord) : void
  + recordDeparture() : void
  + servedCount() : int
  + unhappyDepartures() : int
  + revenueCents() : int
  + paidCount() : int
  + getAveragePaidSatisfaction() : double
  + evaluateResult() : GameResult
}

class CustomerFactory {
  + createCustomer(id: String, ordinal: int, seed: long) : Customer
}

class GameConfig <<value>> {
  - maxTurns : int
  - numTables : int
  - arrivalSchedule : List<Integer>
  - randomSeed : long
  + {static} stageOne(seed: long) : GameConfig
}

' ---------------------------------------------------------------------------
' Value objects (UI contract: IDs and immutable views, never domain entities)
' ---------------------------------------------------------------------------
class GameSnapshot <<value>> {
  - turn : int
  - phase : TurnPhase
  - revenueCents : int
  - averagePaidSatisfaction : Double
  - servedCount : int
  - paidCount : int
  - unhappyDepartures : int
  - turnsUsed : int
  - waitingQueue : List<String>
  - tables : List<TableView>
  - customers : List<CustomerView>
  - orders : List<OrderView>
  - waiterActions : List<WaiterAction>
  - chefActions : List<ChefDecision>
}

class "GameSnapshot.CustomerView" as CustomerView <<value>> {
  - id : String
  - arrivalOrdinal : int
  - state : CustomerState
  - satisfaction : int
  - tableId : Integer
  - queuePosition : Integer
}

class "GameSnapshot.TableView" as TableView <<value>> {
  - id : int
  - occupantId : String
}

class "GameSnapshot.OrderView" as OrderView <<value>> {
  - id : String
  - customerId : String
  - item : String
  - status : OrderStatus
  - unitsDone : int
  - preparationUnits : int
  - lockedPriceCents : int
}

class "GameSnapshot.WaiterAction" as WaiterAction <<value>> {
  - decision : WaiterDecision
  - tableId : Integer
}

class TurnResolution <<value>> {
  - turn : int
  - events : List<String>
  - newArrival : String
  - departingCustomers : List<String>
  - paymentRecord : PaymentRecord
  - isSuccessful : boolean
  - errorMessage : String
  - result : GameResult
}

class PaymentRecord <<value>> {
  - customerId : String
  - lockedPriceCents : int
  - satisfaction : int
}

class WaiterDecision <<value>> {
  - taskType : WaiterTaskType
  - targetCustomerId : String
}

class ChefDecision <<value>> {
  - taskType : ChefTaskType
  - targetCustomerId : String
}

' ---------------------------------------------------------------------------
' Enumerations
' ---------------------------------------------------------------------------
enum CustomerState {
  WAITING
  SEATED
  EATING
  READY_TO_PAY
  PAID
  LEFT
}

enum OrderStatus {
  PLACED
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
}

enum TurnPhase {
  START_OF_TURN
  MANAGER_CHOICES
  RESOLVING
  GAME_OVER
}

enum GameResult {
  VICTORY
  DEFEAT
}

enum WaiterTaskType {
  SEAT
  TAKE_ORDER
  SERVE
  WAIT
}

enum ChefTaskType {
  ADVANCE
  WAIT
}

' ---------------------------------------------------------------------------
' Generalization
' ---------------------------------------------------------------------------
Customer <|-- RegularCustomer
MenuItem <|-- Dish

' ---------------------------------------------------------------------------
' Nested types
' ---------------------------------------------------------------------------
GameSnapshot +-- CustomerView
GameSnapshot +-- TableView
GameSnapshot +-- OrderView
GameSnapshot +-- WaiterAction

' ---------------------------------------------------------------------------
' Composition and aggregation
' ---------------------------------------------------------------------------
Restaurant *-down- "1" WaitingQueue
Restaurant *-down- "1..*" Table
Customer *-down- "1" Satisfaction
WaitingQueue o-right- "0..*" Customer : members
Menu o-down- "1..*" MenuItem : items

' ---------------------------------------------------------------------------
' Direct associations
' ---------------------------------------------------------------------------
ConsoleUI -down-> GameController : controller
GameController -down-> Restaurant : restaurant
GameController -down-> ScoreBoard : scoreBoard
GameController -right-> GameConfig : config
GameController -down-> CustomerFactory : customerFactory
GameController -down-> BillCalculator : billCalculator
GameController -down-> TurnPhase : phase
GameController -down-> "0..1" PaymentRecord : paymentRecord
Restaurant -down-> Menu
Restaurant -down-> "0..*" Customer : customers
Restaurant -down-> Waiter
Restaurant -down-> Chef
Restaurant -down-> Cashier
Table -right-> "0..1" Customer : occupant
Customer -down-> "0..1" Order : order
Customer -down-> CustomerState : state
Order -down-> MenuItem : item
Order -down-> OrderStatus : status
WaiterDecision -right-> WaiterTaskType : taskType
ChefDecision -right-> ChefTaskType : taskType
TurnResolution -down-> "0..1" PaymentRecord : paymentRecord
TurnResolution -down-> "0..1" GameResult : result
GameSnapshot -down-> TurnPhase : phase
GameSnapshot -down-> "0..*" ChefDecision : chefActions
WaiterAction -down-> WaiterDecision : decision
CustomerView -down-> CustomerState : state
OrderView -down-> OrderStatus : status

' ---------------------------------------------------------------------------
' Dependencies
' ---------------------------------------------------------------------------
ConsoleApp .down.> ConsoleUI
ConsoleApp .down.> GameController
ConsoleApp .down.> GameConfig
ConsoleUI .down.> GameSnapshot
ConsoleUI .down.> TurnResolution
ConsoleUI .down.> GameResult
ConsoleUI .down.> TurnPhase
ConsoleUI .down.> WaiterDecision
ConsoleUI .down.> ChefDecision
ConsoleUI .down.> WaiterTaskType
ConsoleUI .down.> ChefTaskType
ConsoleUI .down.> CustomerState
GameController .left.> GameSnapshot
GameController .down.> WaiterDecision
GameController .down.> ChefDecision
GameController .down.> WaiterTaskType
GameController .down.> ChefTaskType
GameController .down.> TurnResolution
GameController .right.> GameResult
GameController .down.> Customer
GameController .down.> CustomerState
GameController .down.> Order
GameController .down.> OrderStatus
GameController .down.> Table
Waiter .up.> Restaurant
Waiter .left.> Customer
Waiter .down.> Menu
Waiter .down.> MenuItem
Waiter .down.> BillCalculator
Waiter .down.> Order
Chef .left.> Customer
Cashier .up.> Restaurant
Cashier .left.> Customer
Cashier .right.> PaymentRecord
ScoreBoard .down.> PaymentRecord
ScoreBoard .up.> GameResult
CustomerFactory .down.> Customer
CustomerFactory .down.> RegularCustomer
BillCalculator .up.> Customer
BillCalculator .down.> MenuItem
Restaurant .down.> PaymentRecord
Restaurant .down.> CustomerState
Table .down.> CustomerState
WaitingQueue .down.> CustomerState
Customer .down.> Menu
Customer .down.> MenuItem

' ---------------------------------------------------------------------------
' Invisible layout guides - these do not appear in the rendered diagram.
' They keep each horizontal band ordered and prevent long edge detours.
' ---------------------------------------------------------------------------
ConsoleApp -[hidden]right- ConsoleUI
ConsoleUI -[hidden]down- GameController
GameSnapshot -[hidden]right- GameController
GameController -[hidden]right- GameConfig
GameConfig -[hidden]right- GameResult

TurnPhase -[hidden]right- Restaurant
Restaurant -[hidden]right- CustomerFactory
CustomerFactory -[hidden]right- WaiterDecision
WaiterTaskType -[hidden]right- ChefDecision
ChefTaskType -[hidden]right- TurnResolution
TurnResolution -[hidden]right- ScoreBoard

CustomerFactory -[hidden]down- Customer
WaiterDecision -[hidden]down- Waiter
ChefDecision -[hidden]down- Chef
TurnResolution -[hidden]down- PaymentRecord

WaitingQueue -[hidden]right- Table
Customer -[hidden]right- Waiter
Waiter -[hidden]right- Chef
Chef -[hidden]right- Cashier

Customer -[hidden]down- Menu
Satisfaction -[hidden]right- Menu
Menu -[hidden]right- Order
Order -[hidden]right- RegularCustomer
RegularCustomer -[hidden]right- CustomerState
CustomerState -[hidden]right- BillCalculator

MenuItem -[hidden]right- OrderStatus

GameSnapshot -[hidden]down- CustomerView
CustomerView -[hidden]right- TableView
TableView -[hidden]right- OrderView
OrderView -[hidden]right- WaiterAction

@enduml
